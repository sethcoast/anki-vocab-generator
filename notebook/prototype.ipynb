    "# Function to call the LLM for translations and example sentences\n",
    "def generate_language_data(vocab_word):\n",
    "    \"\"\"\n",
    "    Given a Japanese vocabulary word, this function uses an LLM to generate:\n",
    "    - English translation of the word\n",
    "    - Example sentence in Japanese using the word\n",
    "    - English translation of the example sentence\n",
    "    \"\"\"\n",
    "    prompt = f\"\"\"\n",
    "    Please provide the following details for the Japanese vocabulary word \"{vocab_word}\":\n",
    "    1. English translation of the word\n",
    "    2. An example sentence in Japanese using the word\n",
    "    3. English translation of the example sentence\n",
    "    \n",
    "    Provide them exactly as specified with no additional editorializing, separated by newline characters for easy processing.\n",
    "    You should output exactly three lines, one for each of the above list.\n",
    "    \"\"\"\n",
    "    try:\n",
    "        client = openai.OpenAI(api_key=OPENAI_API_KEY) \n",
    "        \n",
    "        # Call OpenAI API\n",
    "        response = client.chat.completions.create(\n",
    "            model=\"gpt-4\",\n",
    "            messages=[\n",
    "                {\"role\": \"system\", \"content\": \"You are a helpful assistant for learning Japanese.\"},\n",
    "                {\"role\": \"user\", \"content\": prompt}\n",
    "            ],\n",
    "            max_tokens=300,\n",
    "            temperature=0.7\n",
    "        )\n",
    "        \n",
    "        print(response)\n",
    "        \n",
    "        # Parse response\n",
    "        output = response.choices[0].message.content\n",
    "        return output\n",
    "    except Exception as e:\n",
    "        return f\"Error: {e}\"\n",
    "\n",
    "# Function to generate TTS audio for a given text\n",
    "def generate_audio(text, language=\"ja\", filename=\"output.mp3\"):\n",
    "    \"\"\"\n",
    "    Generate TTS audio for a given text in the specified language.\n",
    "    \"\"\"\n",
    "    try:\n",
    "        tts = gTTS(text=text, lang=language)\n",
    "        tts.save(filename)\n",
    "        return filename\n",
    "    except Exception as e:\n",
    "        return f\"Error generating audio: {e}\"\n",
    "\n",
    "# Prototype workflow\n",
    "def prototype_workflow(vocab_word):\n",
    "    \"\"\"\n",
    "    Complete workflow:\n",
    "    1. Generate language data using the LLM.\n",
    "    2. Generate TTS audio for the vocabulary word and example sentence.\n",
    "    3. Display results and audio playback.\n",
    "    \"\"\"\n",
    "    print(f\"Processing vocabulary word: {vocab_word}\\n\")\n",
    "    \n",
    "    # Step 1: Call the LLM\n",
    "    language_data = generate_language_data(vocab_word)\n",
    "    print(\"Generated Language Data:\\n\", language_data)\n",
    "    \n",
    "    # Split LLM output into components (this can be improved with stricter formatting)\n",
    "    lines = language_data.split(\"\\n\")\n",
    "    try:\n",
    "        english_translation = lines[0]\n",
    "        example_sentence_jp = lines[1]\n",
    "        example_sentence_en = lines[2]\n",
    "    except IndexError:\n",
    "        print(\"Error parsing LLM output.\")\n",
    "        return\n",
    "    \n",
    "    # Step 2: Generate TTS audio\n",
    "    vocab_audio_file = generate_audio(vocab_word, filename=\"vocab_word.mp3\")\n",
    "    sentence_audio_file = generate_audio(example_sentence_jp, filename=\"example_sentence.mp3\")\n",
    "\n",
    "    return {\n",
    "        \"vocab_translation\": english_translation,\n",
    "        \"example_sentence\": example_sentence_jp,\n",
    "        \"example_sentence_translation\": example_sentence_en,\n",
    "        \"vocab_audio\": vocab_audio_file,\n",
    "        \"example_sentence_translation_audio\": sentence_audio_file\n",
    "    }"
   ]
